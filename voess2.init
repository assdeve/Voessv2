#!/bin/sh /etc/rc.common
# OpenWrt: положить в /etc/init.d/voess2 и сделать исполняемым
START=95
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/voess2 server -c /etc/voess/server.json
    procd_set_param respawn
    procd_set_param stderr 1
    procd_close_instance
}
